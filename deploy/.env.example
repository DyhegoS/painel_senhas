# Configuração de produção. Copie para deploy/.env (não vai para o git) e preencha.
#   cp deploy/.env.example deploy/.env

# --- Segurança (obrigatório) ---
# Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Administrador criado no primeiro start (só se ainda não existir nenhum). Troque a senha!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Segredo do agente de impressão (Raspberry Pi). Gere com: openssl rand -hex 16
PRINT_AGENT_TOKEN=
# Segredo dos totens (mesmo valor em EXPO_PUBLIC_TOTEM_TOKEN no mobile/.env). Vazio = não exige
TOTEM_TOKEN=

# --- Rede ---
# Porta em que o sistema fica acessível no servidor
HTTP_PORT=80
# Origens liberadas no CORS. Tudo é servido pelo mesmo endereço, então pode ficar vazio
CORS_ORIGIN=
# true só se o sistema for servido por HTTPS
COOKIE_SECURE=false
# Máximo de senhas geradas por minuto por endereço IP
GENERATE_RATE_LIMIT=30

# --- Painel da TV (aplicados no build: rode de novo com --build ao alterar) ---
PLACE_NAME=Sala de Espera
# URL de uma imagem de logo (opcional)
LOGO_URL=
REPORT_TIMEZONE=America/Sao_Paulo

# --- MongoDB ---
# CPUs sem suporte a AVX não rodam o MongoDB 5+. Veja: grep -c avx /proc/cpuinfo
# Se o resultado for 0, use mongo:4.4
MONGO_IMAGE=mongo:7.0
