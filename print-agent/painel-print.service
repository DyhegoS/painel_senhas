[Unit]
Description=Painel de Senhas - Agente de impressao
After=network-online.target
Wants=network-online.target

[Service]
# Usuário de sistema criado na instalação (veja o README); precisa estar no grupo lp
User=painel
WorkingDirectory=/opt/print-agent
# Ajuste para o IP do servidor que roda o backend
Environment=BACKEND_URL=http://192.168.0.10
Environment=PRINTER_DEVICE=/dev/usb/lp0
Environment=PRINT_AGENT_TOKEN=
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
