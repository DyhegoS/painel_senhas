PORT=5000
MONGODB_URI=mongodb://localhost:27017/painel_senhas
NODE_ENV=development

# Autenticação
JWT_SECRET=troque-por-uma-chave-secreta-longa
JWT_EXPIRES_IN=12h
# Administrador criado automaticamente no primeiro start (se não existir nenhum)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Origens liberadas no CORS, separadas por vírgula (vazio = todas)
CORS_ORIGIN=
# Todo dia à meia-noite (no fuso abaixo) cancela as senhas pendentes e reinicia a numeração em 001.
# Use false para desativar e zerar só manualmente pela aba Filas
AUTO_RESET=true
# Fuso usado nos relatórios, no movimento do dia e na meia-noite do reinício automático
REPORT_TIMEZONE=America/Sao_Paulo
# Segredo compartilhado com o print-agent (Raspberry Pi); vazio = qualquer um pode se registrar como impressora
PRINT_AGENT_TOKEN=
# Segredo dos totens: se definido, /api/tickets/generate exige o cabeçalho X-Totem-Token
# (configure o mesmo valor em EXPO_PUBLIC_TOTEM_TOKEN no mobile/.env)
TOTEM_TOKEN=
# Máximo de senhas geradas por minuto por endereço IP
GENERATE_RATE_LIMIT=30
# true quando o sistema for servido por HTTPS (cookie de sessão só trafega criptografado)
COOKIE_SECURE=false
# Atrás de proxy reverso (nginx etc.), informe quantos proxies há na frente (ex.: 1)
TRUST_PROXY=
