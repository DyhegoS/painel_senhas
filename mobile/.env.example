# Opcional: valores iniciais da tela de ajustes do totem. No aparelho, o endereço e o token
# são configurados pelo próprio app (segure o título por 3 segundos) e ficam salvos nele.
# Endereço do backend na rede local (sem porta em produção; :5000 no desenvolvimento)
EXPO_PUBLIC_BACKEND_URL=http://192.168.15.6:5000
# Igual ao TOTEM_TOKEN do backend (deixe vazio se o backend não exigir)
EXPO_PUBLIC_TOTEM_TOKEN=
